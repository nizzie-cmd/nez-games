# Copy to .env and fill in. Use TEST keys (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional locally: from `stripe listen --forward-to localhost:4242/webhook`, or your dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
PORT=4242
# Public URL of this server, used for Stripe's redirect back after checkout.
BASE_URL=http://localhost:4242
